# ===========================================
# Database (MongoDB)
# ===========================================
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/saree-shop?retryWrites=true&w=majority"

# ===========================================
# Authentication (Clerk)
# ===========================================
# Clerk Dashboard -> API keys. Required: the app does not start without them.
# pk_test_/sk_test_ = development instance, pk_live_/sk_live_ = production
# (production needs your own domain). Setup: docs/AUTHENTICATION.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk Dashboard -> Webhooks -> your endpoint -> Signing secret.
# Endpoint URL: https://<your-domain>/api/webhooks/clerk
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ===========================================
# Application URL
# ===========================================
NEXT_PUBLIC_APP_URL=https://saakiebyknk.in

# ===========================================
# Payment Gateways
# ===========================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ===========================================
# Cloudinary (Image Uploads)
# ===========================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="xxxxxxxxxxxx"
CLOUDINARY_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ===========================================
# Image Watermarking (optional)
# ===========================================
# Set to "true" to burn the ownership watermark into Cloudinary product
# images at delivery time (lib/image-watermark.ts). Off by default.
WATERMARK_ENABLED=false

# ===========================================
# Instagram (optional)
# ===========================================
INSTAGRAM_ACCESS_TOKEN=your_long_lived_instagram_access_token

# ===========================================
# AI — Fashion Assistant
# ===========================================
# Anthropic Claude is the chat provider (lib/ai/claude.ts → /api/chat).
# Get a key + add prepaid credit at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI is used later for embeddings (Phase 5 RAG) and voice (Phase 13).
# Get a key + add credit at https://platform.openai.com
# OPENAI_API_KEY=sk-...

# ===========================================
# Database backups (admin → /admin/backup)
# ===========================================
# A database on a SEPARATE cluster. "Separate" is the whole point: a backup on
# the same cluster dies with it. The app refuses to run if this resolves to the
# same host + database as DATABASE_URL.
# Only a SUPER_ADMIN can trigger a backup. See docs/BACKUP.md.
BACKUP_DATABASE_URL=mongodb+srv://user:pass@backup-cluster.mongodb.net/saakie_backup

